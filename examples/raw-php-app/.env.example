MOOLRE_PRODUCTION=false
MOOLRE_ACCOUNT_NUMBER=your_account_number
MOOLRE_API_USER=your_moolre_account_username
# Required when MOOLRE_PRODUCTION=true. Optional in sandbox.
MOOLRE_PUBLIC_KEY=
# Optional advanced override. Normally MOOLRE_PRODUCTION selects the endpoint.
# MOOLRE_BASE_URL=https://sandbox.moolre.com/embed/src/start
# Optional advanced override for transaction verification.
# MOOLRE_VERIFICATION_URL=https://sandbox.moolre.com/open/transact/status
MOOLRE_CURRENCY=GHS
# Optional. Minimum is 1 minute when set.
MOOLRE_EXPIRATION_TIME=10
APP_URL=http://localhost:8080
# Optional on Windows if PHP cannot verify HTTPS certificates:
# MOOLRE_CA_FILE=C:\path\to\cacert.pem
