{
  "name": "moolre/moolre-php",
  "description": "PHP SDK for Moolre: hosted checkout (Client) plus a full server SDK (Moolre\\Moolre) for collections, payouts, name validation, sales, SMS, WhatsApp, payment links, bulk payouts and webhook verification.",
  "type": "library",
  "keywords": [
    "ghana",
    "mobile-money",
    "moolre",
    "payment",
    "payments",
    "payouts",
    "php-sdk",
    "sms",
    "webhooks",
    "whatsapp"
  ],
  "homepage": "https://github.com/moolrehq/moolre-php",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Moolre",
      "homepage": "https://github.com/moolrehq"
    }
  ],
  "support": {
    "email": "hello@moolre.com",
    "issues": "https://github.com/moolrehq/moolre-php/issues",
    "source": "https://github.com/moolrehq/moolre-php",
    "docs": "https://docs.moolre.com/sdks"
  },
  "require": {
    "php": "^7.4 || ^8.0",
    "composer/ca-bundle": "^1.5",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0",
    "phpstan/phpstan": "1.12"
  },
  "autoload": {
    "psr-4": {
      "Moolre\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Moolre\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "smoke": "php tests/smoke.php",
    "test": [
      "@smoke",
      "@phpunit",
      "@sdk-test"
    ],
    "phpunit": "@php vendor/bin/phpunit",
    "analyse": "@php vendor/bin/phpstan analyse --no-progress",
    "prepublish-check": "@php scripts/prepublish-check.php",
    "sdk-test": "@php tests/sdk/run.php",
    "bundle": "@php scripts/bundle.php"
  },
  "minimum-stability": "stable",
  "suggest": {
    "ext-curl": "Required by Moolre\\Moolre (the server SDK); the legacy Client falls back to PHP streams without it."
  }
}
